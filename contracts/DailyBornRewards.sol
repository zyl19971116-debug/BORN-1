pragma solidity ^0.8.24;
import "@openzeppelin/contracts/token/ERC20/IERC20.sol";import "./PermissionlessMemeFactory.sol";import "./DailyMarketCapOracle.sol";
contract DailyBornRewards {uint256 public constant DAILY_REWARD=1_000_000 ether;IERC20 public immutable born;PermissionlessMemeFactory public immutable factory;DailyMarketCapOracle public immutable oracle;mapping(uint256=>bool) public settled;event DailyRewardPaid(uint256 indexed day,address indexed token,address indexed creator,uint256 amount);constructor(address born_,address factory_,address oracle_){born=IERC20(born_);factory=PermissionlessMemeFactory(factory_);oracle=DailyMarketCapOracle(oracle_);}function settleDay(uint256 day) external{require(day<block.timestamp/1 days,"Day not closed");require(!settled[day],"Already settled");(address token,,)=oracle.dailyWinner(day);address creator=factory.creatorOf(token);require(creator!=address(0),"Unknown token");settled[day]=true;require(born.transfer(creator,DAILY_REWARD),"Reward transfer failed");emit DailyRewardPaid(day,token,creator,DAILY_REWARD);}}
